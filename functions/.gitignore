# Never commit the real token — this file holds it as a plain
# environment variable for local emulation/testing only.
.env
.env.local

# Service account key used only by migrate-admin-accounts.js — this file
# grants full admin access to the whole Firebase project. Never commit it.
serviceAccountKey.json

# Installed dependencies — reinstalled via `npm install`, not committed.
node_modules/

# Firebase CLI local state / logs
.firebase/
firebase-debug.log
firebase-debug.*.log
